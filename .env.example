# Copy to .env and fill in. Never commit .env.

# --- App ---
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ORIGINS=http://localhost:3000

# --- Database ---
# Local (non-Docker) development. docker-compose overrides this for the backend container.
DATABASE_URL=postgresql+psycopg://sociallens:sociallens@localhost:5432/sociallens
POSTGRES_USER=sociallens
POSTGRES_PASSWORD=sociallens
POSTGRES_DB=sociallens

# --- Storage ---
STORAGE_BACKEND=local
MAX_UPLOAD_MB=20

# --- AI ---
# anthropic | openai | gemini | none   (analytics work without any AI provider)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Re-run classifier-declined requests on Anthropic's recommended fallback model
ANTHROPIC_FALLBACKS=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Google AI Studio (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Reasoning depth for Claude: low | medium | high | xhigh | max
AI_EFFORT=high

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
